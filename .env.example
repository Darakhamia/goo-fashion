# ── Site ─────────────────────────────────────────────────────────────────────
# Public base URL. Used to build monobank redirect + webhook URLs, so it MUST be
# the real, publicly reachable origin in production (monobank calls it server-side).
NEXT_PUBLIC_SITE_URL=https://www.goo-fashion.com

# ── monobank acquiring (Plata by mono) ───────────────────────────────────────
# Merchant token from https://web.monobank.ua → Plata by mono → API tokens.
MONOBANK_TOKEN=
# Optional — defaults to https://api.monobank.ua
# MONOBANK_API_BASE=https://api.monobank.ua

# Plan prices in HRYVNIA (UAH). monobank acquiring charges in UAH only — it
# cannot bill USD/EUR directly. Optional; sensible defaults live in src/lib/plans.ts.
# MONOBANK_PRICE_BASIC=399
# MONOBANK_PRICE_PRO=999
# MONOBANK_PRICE_PREMIUM=1799

# Secret guarding the auto-renewal cron endpoint (/api/billing/cron/renew).
# Vercel Cron automatically sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI / other integrations (see code for usage) ──────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
