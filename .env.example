# Goo Fashion — environment variables
#
# Copy to .env.local for local development (`cp .env.example .env.local`) and
# fill in what you need. On production the same names are set in Coolify.
# Every variable the live code reads is listed here (NODE_ENV is set by Next
# itself). Commented-out lines are optional: the default in the comment is what
# the code uses when unset.
#
# NEXT_PUBLIC_* values are baked into the bundle by `next build`. In Coolify
# they must be available at build time, not only at runtime, or the build ships
# without them. SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are needed at build
# time too: the build prerenders the home page, sitemap and blog from the
# database, and without them those pages ship the demo catalogue until ISR
# regenerates them.
#
# Never commit real values. .env* files are git-ignored; only this template is
# tracked, and it must stay free of secrets.

# ── Site ─────────────────────────────────────────────────────────────────────
# Public origin, no trailing slash. Unset → https://goo-fashion.com, which is
# already the right production value; a wrong value is what does damage.
# Used for canonical URLs, sitemap, robots, Open Graph, and the monobank
# redirect + webhook URLs. Use the apex domain, WITHOUT www: the site answers
# www with a 308 redirect to the apex, so a www value sends payment webhooks
# to a redirect.
NEXT_PUBLIC_SITE_URL=https://goo-fashion.com

# ── Auth (Clerk) ─────────────────────────────────────────────────────────────
# Required. Sign-in, accounts, user plan (publicMetadata.plan) and the admin
# flag all live in Clerk. Without the publishable key the build still passes
# (layout.tsx falls back to a dummy key), but sign-in and /goo-studio do not
# work. The secret key is read by @clerk/nextjs itself, on the server.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Database and file storage (Supabase) ─────────────────────────────────────
# Required in production. Production runs a self-hosted Supabase
# (see MIGRATION_RUNBOOK.md). The app talks to it only from the server, with
# the service-role key — never expose that key to the browser.
# Without both values the site serves the built-in demo catalogue (meant for
# local development only) and every save, admin write and upload fails.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Ceiling for a single Supabase request, in ms. Default 60000.
# SUPABASE_REQUEST_TIMEOUT_MS=60000
# Optional, normally not needed. Read only by /api/looks/image as an extra
# host a look photo may be downloaded from; SUPABASE_URL already covers it.
# NEXT_PUBLIC_SUPABASE_URL=

# ── Admin panel (/goo-studio) ────────────────────────────────────────────────
# Clerk user IDs (user_...) of admins, comma-separated. Checked on the server
# (proxy.ts + every /api/admin route). Empty → nobody gets in, except users
# whose Clerk publicMetadata has isAdmin=true (granted from Studio → Users).
# That flag is read from the session token, so it only works if the Clerk
# session token is customised to carry public metadata; whether production's
# is — confirm with the CEO. This list works regardless.
# Also the default recipients of billing alerts.
ADMIN_USER_IDS=
# Clerk user ID of the one super admin; must also be an admin. Only the super
# admin can open Activity (the admin action log) and grant or revoke admin
# access, and nobody can edit or delete their account from Studio → Users.
# Checked only on the server; the browser learns it from GET /api/admin/me.
# Empty → Activity answers 403 to everyone and nobody can change admin access.
# (NEXT_PUBLIC_SUPER_ADMIN_USER_ID is no longer read anywhere.)
SUPER_ADMIN_USER_ID=

# ── AI ───────────────────────────────────────────────────────────────────────
# Replicate: the AI stylist chat (an LLM served through Replicate) and outfit
# image generation. Without it both answer 501.
REPLICATE_API_TOKEN=
# Optional. LLM the stylist runs on Replicate. Default openai/gpt-4.1.
# STYLIST_LLM_MODEL=openai/gpt-4.1

# OpenAI: embeddings (stylist semantic search), AI extraction in the parser,
# blog post generation, AI-written emails, bug-report triage. Optional here:
# the key can instead be saved in Studio → Settings (settings table); the env
# value wins when both exist. With neither, those features are off. The
# stylist chat itself does not need it.
OPENAI_API_KEY=
# Optional. Semantic (vector) search in the stylist, off by default. Turn on
# (1 / true / yes) only after product embeddings are backfilled
# (Studio → Settings → Embeddings); needs an OpenAI key.
# STYLIST_SEMANTIC_SEARCH=1
# Optional. Minimum cosine similarity for a semantic match. Default 0.2.
# STYLIST_SEMANTIC_MIN_SIM=0.2

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Studio → Email (mail to users) and billing alerts. Without the key the Email
# section cannot send, and billing alerts only reach the server log.
RESEND_API_KEY=
# Optional. Sender; must be on a domain verified in Resend.
# Default "GOO Fashion <hello@goo-fashion.com>".
# RESEND_FROM_EMAIL="GOO Fashion <hello@goo-fashion.com>"

# ── Payments and billing (monobank acquiring, Plata by mono) ─────────────────
# Merchant token from https://web.monobank.ua → Plata by mono → API tokens.
# Without it checkout answers 503 and the renewal cron does nothing.
MONOBANK_TOKEN=
# Optional. Default https://api.monobank.ua
# MONOBANK_API_BASE=https://api.monobank.ua

# Optional. Plan prices in hryvnia (monobank charges UAH only).
# Defaults 399 / 999 / 1799 (src/lib/plans.ts).
# CAUTION: read on the server only. /plans, /subscribe, /profile and the
# upgrade modal are client components, so in the browser they show the
# defaults: a different price here is charged but not shown. Leave unset
# until fixed.
# MONOBANK_PRICE_BASIC=399
# MONOBANK_PRICE_PRO=999
# MONOBANK_PRICE_PREMIUM=1799

# Required for auto-renewal. Guards GET /api/billing/cron/renew.
# Production runs on Coolify, where the cron in vercel.json does NOT run:
# add a Coolify Scheduled Task that calls this URL once a day with the header
# "Authorization: Bearer $CRON_SECRET" (details in BILLING.md; whether the
# task exists on production — confirm with the CEO). Empty → the endpoint
# answers 401 to every call, no subscription renews or downgrades, and a call
# also sends a billing alert (at most one per 12 h).
CRON_SECRET=

# Optional. Billing alert recipients, comma-separated. Default: the emails of
# the Clerk accounts in ADMIN_USER_IDS. Sending needs RESEND_API_KEY.
# BILLING_ALERT_EMAIL=
# Optional. UAH per 1 USD, only for the $ figures on Studio → Subscriptions
# (charges are always exact UAH). Default 41.
# BILLING_USD_UAH_RATE=41

# ── Product analytics (PostHog) ──────────────────────────────────────────────
# Optional. Without the key PostHog and the cookie-consent banner are off.
# With it, tracking starts only after the visitor accepts analytics cookies.
NEXT_PUBLIC_POSTHOG_KEY=
# Optional. Default https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── Rate limits (Upstash Redis) ──────────────────────────────────────────────
# Optional but expected in production. Rate limits for the stylist chat
# (per minute, plus the daily cap for anonymous visitors), bug reports, look
# sharing and analytics beacons. Without both values every one of these limits
# is off (requests pass through): anonymous visitors can then use the stylist
# with no daily cap, spending Replicate credits. Per-plan daily caps for
# signed-in users are counted in Supabase and keep working.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Product parser (Studio → Parser) ─────────────────────────────────────────
# Optional. API key of the scraping provider (ScrapingBee / ScraperAPI /
# ZenRows / custom endpoint). Only needed when the parser's fetch mode is not
# "direct". Falls back to the key saved in Studio → Parser → Fetch & Anti-bot.
PARSER_FETCH_API_KEY=

# ── Internal bug reports (/report) ───────────────────────────────────────────
# The floating "report a bug" button appears after opening any page with
# ?internal=true; the form needs a signed-in user and the OpenAI key.
# Optional. API key of the Plane instance the report form posts issues to
# (plane.goo-fashion.com, hard-coded in /api/report-bug). As of 2026-08-21 that
# host did not resolve (MIGRATION_RUNBOOK.md §1.9); what to do with the Plane
# integration is a CEO decision. Without a working key/host the report fails
# after the OpenAI call.
# PLANE_API_KEY=

# ── Build info ───────────────────────────────────────────────────────────────
# Optional. Commit shown in the Studio card-export archive report. Vercel sets
# it automatically; Coolify does not, so the report says
# "local (not a deployed build)" unless you pass it yourself.
# VERCEL_GIT_COMMIT_SHA=
