# Force devDependencies to install during the deploy build.
#
# The Railway/nixpacks build runs `npm ci` with NODE_ENV=production, which makes
# npm omit devDependencies. But `next build` needs several of them at build time
# (typescript, tailwindcss, @tailwindcss/postcss, @types/*). Without this the
# build fails. `production=false` overrides the NODE_ENV-based omission so the
# build deps are always present.
production=false

# Make `npm ci` resilient to transient registry drops during the deploy build.
# The Railway/nixpacks builder has intermittently failed with ECONNRESET /
# "network aborted" while fetching packages. These settings retry failed
# downloads with backoff instead of aborting the whole build on the first blip.
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
# Per-request ceiling. This was 600000, which defeated the retries above: a
# single stalled download held the whole install for ten minutes before the
# first retry was even attempted, and five of those outlast any platform build
# timeout — so a blip the retries existed to survive could instead kill the
# deploy with no error in the log. Two minutes is comfortable for the largest
# package in this tree (sharp's libvips binary, ~10 MB) on any working link, and
# short enough that a stall becomes a retry instead of a timeout.
fetch-timeout=120000
